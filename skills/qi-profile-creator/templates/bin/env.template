#!/usr/bin/env bash
# bin/env — the product inside this VM (quality-inspector docs/profile-contract.md →
# The bin/ contract).
#
#   init | up <build> | reset | status | down
#
# Acting commands, called by the agent under its environment lock. Every step is
# idempotent and a failed `up` is safe to re-run. State lives in QI_ENV_DIR; nothing
# secret is ever printed.
set -u
export LC_ALL=C

ENVD="${QI_ENV_DIR:?QI_ENV_DIR is required}"
CRED="$ENVD/credentials.env"
STATE="$ENVD/STATE.json"
CFG="${QI_PROFILE_CONFIG:-}"; [ -n "$CFG" ] || CFG='{}'
cfgv() { jq -r --arg k "$1" '.[$k] // empty' <<<"$CFG"; }

APP_URL="http://localhost:8080/"   # TODO(profile): profile.json app.url, with a trailing slash
USERS="owner"                       # TODO(profile): every account tests sign in as; owner is required

die() { echo "env: $*" >&2; exit 1; }
say() { echo "env: $*" >&2; }
now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
rand() { head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' | cut -c1-24; }
cred() { sed -n "s/^$1=//p" "$CRED"; }   # cred E2E_USER_OWNER_PASSWORD — use it, never print it
ui_code() { curl -s -o /dev/null -w '%{http_code}' --noproxy '*' --max-time 10 "$APP_URL" 2>/dev/null; }

# ------------------------------------------------------------ the product part ----
# Install or upgrade to exactly <build>, the accounts in $CRED included. Forward-only is
# fine: the core runs `reset` before every downgrade.
product_start() { # <build>
  local build="$1"
  # TODO(profile): pull and start "$build"; create or update the owner account from
  # "$(cred E2E_USER_OWNER_USERNAME)" / "$(cred E2E_USER_OWNER_PASSWORD)".
  die "product_start is not written yet ($build)"
}
# Exit 0 once the product is usable — extend when the UI answers before it is.
product_ready() { case "$(ui_code)" in (2??|3??) return 0;; (*) return 1;; esac; }
# Exit 0 when the product's processes or containers run.
product_running() {
  # TODO(profile): e.g. a kubectl, docker or PID-file check.
  return 1
}
# Stop it; data may stay.
product_stop() {
  # TODO(profile)
  :
}
# Delete all product data, so the next `up` starts with fresh users and no content.
product_wipe() {
  # TODO(profile)
  :
}

# ---------------------------------------------------------------- commands ----
cmd_init() {
  mkdir -p "$ENVD" && chmod 700 "$ENVD"
  [ -f "$CRED" ] && return 0
  local u U
  ( umask 077
    for u in $USERS; do
      U="$(printf '%s' "$u" | tr '[:lower:]' '[:upper:]')"
      printf 'E2E_USER_%s_USERNAME=qa-%s\nE2E_USER_%s_PASSWORD=%s\n' "$U" "$u" "$U" "$(rand)"
    done > "$CRED.tmp"
    mv -f "$CRED.tmp" "$CRED" )
  say "seeded the test credentials"
}

cmd_up() {
  local build="${1:?usage: env up <build>}" i
  [ -f "$CRED" ] || cmd_init
  product_start "$build"
  for i in $(seq 1 60); do product_ready && break; sleep 10; done
  product_ready || die "not reachable at $APP_URL after 10 minutes (last HTTP $(ui_code))"
  printf '{"build":"%s","installed_utc":"%s"}\n' "$build" "$(now)" > "$STATE"
  say "$build is up at $APP_URL"
}

cmd_reset() {
  product_stop
  product_wipe
  rm -f "$STATE"
}

cmd_status() {
  local running=false build="" ui=000
  product_running && running=true
  [ -f "$STATE" ] && build="$(jq -r '.build // empty' "$STATE" 2>/dev/null)"
  [ "$running" = true ] && ui="$(ui_code)"
  jq -nc --argjson r "$running" --arg b "$build" --arg u "$ui" \
    '{running: $r, build: (if $b == "" then null else $b end), ui_http: $u}'
}

cmd_down() { product_stop; }

case "${1:-}" in
  init)   cmd_init ;;
  up)     cmd_up "${2:-}" ;;
  reset)  cmd_reset ;;
  status) cmd_status ;;
  down)   cmd_down ;;
  *) echo "usage: $0 init|up <build>|reset|status|down" >&2; exit 2 ;;
esac
