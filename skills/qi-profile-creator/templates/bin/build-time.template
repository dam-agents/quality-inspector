#!/usr/bin/env bash
# bin/build-time <build> — when that build was published, one ISO-8601 UTC timestamp
# (quality-inspector docs/profile-contract.md → The bin/ contract). Read-only.
#
# Reads the image's org.opencontainers.image.created annotation, else its config's
# `created`, through a multi-arch index when there is one. No recorded time → non-zero.
set -u -o pipefail   # a failed request inside a pipe must fail the command, never shorten the listing
export LC_ALL=C
CFG="${QI_PROFILE_CONFIG:-}"; [ -n "$CFG" ] || CFG='{}'
TAG="${1:?usage: build-time <build>}"

# TODO(profile): the same repository bin/versions lists.
REF="$(jq -r '.image_ref // empty' <<<"$CFG")"
[ -n "$REF" ] || { echo "no image repository configured" >&2; exit 1; }
HOST="${REF%%/*}"; REPO="${REF#*/}"
[ "$HOST" = docker.io ] && HOST=registry-1.docker.io

token() {
  local www realm service
  www="$(curl -sS -o /dev/null -D - --max-time 20 "https://$HOST/v2/" | tr -d '\r' \
    | sed -n 's/^[Ww][Ww][Ww]-[Aa]uthenticate: Bearer //p')"
  [ -n "$www" ] || return 0
  realm="$(printf '%s' "$www" | sed -n 's/.*realm="\([^"]*\)".*/\1/p')"
  service="$(printf '%s' "$www" | sed -n 's/.*service="\([^"]*\)".*/\1/p')"
  curl -fsS --max-time 20 "$realm?service=$service&scope=repository:$REPO:pull" | jq -r '.token // .access_token // empty'
}
TOK="$(token)"
ACCEPT='application/vnd.oci.image.index.v1+json,application/vnd.docker.distribution.manifest.list.v2+json,application/vnd.oci.image.manifest.v1+json,application/vnd.docker.distribution.manifest.v2+json'
get() { # <path> [<accept>]
  curl -fsSL --max-time 20 ${TOK:+-H "Authorization: Bearer $TOK"} -H "Accept: ${2:-$ACCEPT}" "https://$HOST$1"
}

M="$(get "/v2/$REPO/manifests/$TAG")" || { echo "no manifest for $TAG" >&2; exit 1; }
TS="$(jq -r '.annotations["org.opencontainers.image.created"] // empty' <<<"$M")"
if [ -z "$TS" ] && jq -e '.manifests' <<<"$M" >/dev/null 2>&1; then
  # An index: the first platform image (attestation manifests carry os "unknown").
  D="$(jq -r '[.manifests[] | select((.platform.os // "") != "unknown")][0].digest // empty' <<<"$M")"
  [ -n "$D" ] && M="$(get "/v2/$REPO/manifests/$D")" || M='{}'
  TS="$(jq -r '.annotations["org.opencontainers.image.created"] // empty' <<<"$M")"
fi
if [ -z "$TS" ]; then
  C="$(jq -r '.config.digest // empty' <<<"$M")"
  [ -n "$C" ] && TS="$(get "/v2/$REPO/blobs/$C" '*/*' | jq -r '.created // empty')"
fi
TS="$(printf '%s' "$TS" | sed -E 's/\.[0-9]+Z$/Z/')"
printf '%s' "$TS" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$' \
  || { echo "no publish time recorded for $TAG" >&2; exit 1; }
printf '%s\n' "$TS"
