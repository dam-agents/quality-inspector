{
  "schema": "qi-profile/v1",
  "product": "<fill: the product's name as users know it>",
  "app": { "url": "http://localhost:<fill: UI port>" },
  "issues": { "provider": "github" },
  "engine": "helm-k3s",
  "engine_config": {
    "chart": "{{config:chart_ref}}",
    "registry_api": "<fill: quay (chart on quay.io) or oci (any other registry)>",
    "release": "<fill: Helm release name>",
    "namespace": "default",
    "app_port": "<fill: the same port as app.url>",
    "traefik_port": true,
    "apply_chart_crds": true,
    "channels": {
      "main": { "tag": "<fill: anchored regex of a dev build tag, e.g. ^0\\.0\\.0-main\\.[0-9]+$>", "order": "numeric-suffix" },
      "release": { "tag": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "order": "semver" }
    },
    "default_candidate": "main",
    "default_baseline": "release",
    "helm_version": "{{config:helm_version}}",
    "credentials": { "users": { "owner": { "username": "qa-owner" } }, "secrets": [] },
    "prerequisites": [],
    "values": {
      "<fill: the chart value that creates the first account>": {
        "username": "{{user:owner.username}}",
        "password": "{{user:owner.password}}"
      }
    },
    "overlays": []
  },
  "boundary": { "github_paths": ["actions/runs?per_page=1", "releases?per_page=1"], "urls": [] },
  "egress": [
    { "host": "<fill: the chart and image registry>", "method": "GET", "why": "chart and image pulls, tag listings" },
    { "host": "get.helm.sh", "method": "GET", "why": "the helm binary" }
  ],
  "requires": { "root": true, "commands": ["k3s", "curl", "jq", "node"], "memory_gi": 8 },
  "config": {
    "chart_ref": { "default": "oci://<fill: registry>/<fill: chart repository>", "about": "OCI chart the builds come from" },
    "helm_version": { "default": "v3.19.0", "about": "helm downloaded into the home" }
  }
}
