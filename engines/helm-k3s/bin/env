#!/usr/bin/env bash
# bin/env — a Helm-charted product inside this VM: k3s, the profile's prerequisites, then
# the chart at the build under test (README → Configuration, docs/profile-contract.md).
#
#   init | up <tag> | reset | status | down
#
# Acts only on the local nested cluster. Every step is idempotent; a failed `up` is safe
# to re-run. State lives in QI_ENV_DIR; nothing secret is ever printed.
set -u
export LC_ALL=C
. "$(dirname "$0")/../lib/common.sh"

HOME_DIR="${HOME:-/home/agent}"
ENVD="${QI_ENV_DIR:?QI_ENV_DIR is required}"
CRED="$ENVD/credentials.env"
CFG="$(engine_config)" || exit 1
cfgv() { jq -r "$1 // empty" <<<"$CFG"; }
CHART="$(cfgv .chart)"; RELEASE="$(cfgv .release)"; RELEASE="${RELEASE:-app}"
NS="$(cfgv .namespace)"; NS="${NS:-default}"; APP_PORT="$(cfgv .app_port)"
HELM_VERSION="$(cfgv .helm_version)"; HELM_VERSION="${HELM_VERSION:-v3.19.0}"
PRUNE_BELOW_GI="$(cfgv .prune_below_gi)"; case "$PRUNE_BELOW_GI" in (''|*[!0-9]*) PRUNE_BELOW_GI=20;; esac
export KUBECONFIG=/etc/rancher/k3s/k3s.yaml

die() { echo "env: $*" >&2; exit 1; }
say() { echo "env: $*" >&2; }
kc() { k3s kubectl "$@"; }
now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
rand() { head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' | cut -c1-24; }
app_url() { printf 'http://localhost:%s/' "$APP_PORT"; }

# ------------------------------------------------------------------- init ----
cmd_init() {
  mkdir -p "$ENVD" && chmod 700 "$ENVD"
  [ -f "$CRED" ] && return 0
  ( umask 077
    jq -r '.credentials.users // {} | to_entries[] | "\(.key|ascii_upcase) \(.value.username)"' <<<"$CFG" \
      | while read -r u name; do
          printf 'E2E_USER_%s_USERNAME=%s\nE2E_USER_%s_PASSWORD=%s\n' "$u" "$name" "$u" "$(rand)"
        done > "$CRED.tmp"
    jq -r '.credentials.secrets // [] | .[] | ascii_upcase' <<<"$CFG" \
      | while read -r s; do printf 'QI_SECRET_%s=%s\n' "$s" "$(rand)"; done >> "$CRED.tmp"
    mv -f "$CRED.tmp" "$CRED" )
  say "seeded the test credentials"
}

# --------------------------------------------------------------------- up ----
# k3s and kubectl come with the image; helm does not, so a pinned release goes into the home.
ensure_helm() {
  local bin="$HOME_DIR/.local/bin" arch tmp
  export PATH="$bin:$PATH"
  [ "$(helm version --short 2>/dev/null | cut -d+ -f1)" = "$HELM_VERSION" ] && return 0
  case "$(uname -m)" in (x86_64) arch=amd64;; (aarch64|arm64) arch=arm64;; (*) die "unsupported arch $(uname -m)";; esac
  tmp="/tmp/quality-inspector-helm"; rm -rf "$tmp"; mkdir -p "$tmp" "$bin"
  curl -fsSL --max-time 120 "https://get.helm.sh/helm-$HELM_VERSION-linux-$arch.tar.gz" | tar -xz -C "$tmp" \
    || { rm -rf "$tmp"; die "helm $HELM_VERSION download failed (allow get.helm.sh)"; }
  mv -f "$tmp/linux-$arch/helm" "$bin/helm" && chmod 755 "$bin/helm"; rm -rf "$tmp"
}

k3s_running() { kc get --raw=/readyz >/dev/null 2>&1; }

# ---------------------------------------------------------------- kvm ----
# `kvm: true` — the product's pods open /dev/kvm (a VM runner) from inside a user namespace
# (hostUsers: false). The device comes from the platform that hosts this VM (nested
# virtualization), never from the engine: without it the install still runs and `status`
# says `kvm: false`. In a user namespace the device keeps its host owner unmapped, so a
# 0660 root:kvm device opens for nobody: it is opened to all, at every `up` (a restart
# resets its mode). And runc cannot idmap a volume whose source is on an overlay, which
# this VM's root is: the kubelet's root (the pods' emptyDirs) and every `host_dirs` entry
# go to the home disk instead.
SHARE="$HOME_DIR/.local/share"
NODE="${QI_NODE_ROOT:-}"   # / — the offline tests put a directory in its place (test_engine_kvm.sh)
KUBELET_DROPIN="$NODE/etc/rancher/k3s/config.yaml.d/60-kubelet-root.yaml"
on_overlay() { # <path>: it, or its nearest parent that exists, is on an overlay
  local p="$1"; while [ ! -e "$p" ]; do p="$(dirname "$p")"; done
  [ "$(stat -f -c %T "$p" 2>/dev/null)" = overlayfs ]
}
kvm_wanted() { [ "$(cfgv .kvm)" = true ]; }
kvm_open() {
  kvm_wanted || return 0
  if [ ! -e "$NODE/dev/kvm" ]; then
    say "no /dev/kvm in this VM: the product's VMs will not start (the platform that hosts this agent gives no nested virtualization)"
    return 0
  fi
  chmod 0666 "$NODE/dev/kvm" 2>/dev/null || say "could not open /dev/kvm to all — the product's VMs may not start"
}
kvm_state() { # true | false | null (not asked for)
  kvm_wanted || { echo null; return; }
  [ -e "$NODE/dev/kvm" ] && echo true || echo false
}
# The kubelet's root moves when it is on an overlay and no drop-in moves it yet. A
# kubelet that already runs keeps its root, so k3s stops first; the drop-in is written
# only once it has, so a stop that fails leaves none and the next `up` tries again.
kubelet_root_needed() {
  kvm_wanted && on_overlay "$NODE/var/lib/kubelet" || return 1
  if on_overlay "$SHARE"; then say "/var/lib/kubelet and $SHARE are both on an overlay — the product's VMs will not start"; return 1; fi
  ! grep -qF "root-dir=$SHARE/kubelet" "$KUBELET_DROPIN" 2>/dev/null
}
kubelet_root_write() {
  mkdir -p "$(dirname "$KUBELET_DROPIN")" "$SHARE/kubelet"
  printf '%s\n' "# The machine root is an overlay, where runc cannot idmap a user-namespace pod's" \
    "# volumes: the kubelet keeps them on the home disk (quality-inspector, helm-k3s)." \
    "kubelet-arg+:" "  - \"root-dir=$SHARE/kubelet\"" > "$KUBELET_DROPIN"
}
# `host_dirs`: the node directories the chart hands such pods. Each one on an overlay and
# not yet a mount point gets $SHARE/host<path> bind-mounted over it, at every `up` (a bind
# mount does not outlive the VM); what it held before is copied over first. <path> is the
# whole path, `-` doubled and `/` made `-` (/var/lib/vm-images → host-var-lib-vm--images),
# so two directories never share a source. Prints the directories it mounted.
host_dirs_mount() {
  local dir at src
  while IFS= read -r dir; do
    [ -n "$dir" ] || continue
    at="$NODE$dir"
    ! mountpoint -q "$at" 2>/dev/null || continue
    on_overlay "$at" || continue
    if on_overlay "$SHARE"; then say "$dir and $SHARE are both on an overlay — a user-namespace pod cannot mount it"; continue; fi
    src="$SHARE/host$(printf '%s' "$dir" | sed 's/-/--/g; s#/#-#g')"
    mkdir -p "$src" "$at"
    [ -z "$(ls -A "$at")" ] || [ -n "$(ls -A "$src")" ] || cp -a "$at/." "$src/"
    mount --bind "$src" "$at" || { say "could not mount $src over $dir"; continue; }
    printf '%s\n' "$dir"
  done < <(jq -r '.host_dirs // [] | .[] | sub("/+$"; "")' <<<"$CFG")
}
# A pod that started before its directory was mounted keeps the overlay one (the chart may
# hand a subdirectory of it): delete it, and its controller starts it again on the mount.
restart_pods_on() { # <dir>...
  [ $# -gt 0 ] || return 0
  local dirs; dirs="$(printf '%s\n' "$@" | jq -R . | jq -sc .)"
  kc get pods -A -o json 2>/dev/null \
    | jq -r --argjson d "$dirs" '.items[]
        | select(any(.spec.volumes[]?.hostPath.path // empty; . as $p | any($d[]; . as $x | $p == $x or ($p | startswith($x + "/")))))
        | "\(.metadata.namespace) \(.metadata.name)"' \
    | while read -r ns pod; do kc -n "$ns" delete pod "$pod" --wait=false >/dev/null 2>&1 || true; done
}
# What k3s-killall.sh does for a plain k3s process: pods outlive it in their shims, with
# their mounts and their iptables rules — so a kubelet started on a new root would find
# the old pods' mounts and a stale hostport rule.
stop_k3s() {
  pkill -f 'k3s server' 2>/dev/null || true
  local i; for i in $(seq 1 30); do pgrep -f 'k3s server' >/dev/null || break; sleep 1; done
  pgrep -f 'k3s server' >/dev/null && return 1
  pkill -9 -f '/k3s/data/[^ ]*/containerd-shim' 2>/dev/null || true
  for i in 1 2 3; do
    mount | awk '{print $3}' | grep -E -e '^/(run/k3s|var/lib/kubelet|var/lib/rancher/k3s|run/netns|var/run/netns)' -e "^$SHARE/kubelet/" \
      | sort -r | xargs -r -n1 umount -l 2>/dev/null || true
  done
  local b; for b in iptables iptables-legacy; do
    command -v "$b-save" >/dev/null 2>&1 || continue
    "$b-save" 2>/dev/null | grep -v -e KUBE- -e CNI- -e FLANNEL -e flannel | "$b-restore" 2>/dev/null || true
  done
  rm -rf "$NODE/var/lib/cni"
}
# The node side of `kvm` and `host_dirs`, before k3s starts where it can.
node_prepare() {
  local mounted=() was=0 d
  k3s_running && was=1
  kvm_open
  while IFS= read -r d; do mounted+=("$d"); done < <(host_dirs_mount)
  if kubelet_root_needed; then
    if [ "$was" = 1 ]; then
      say "stopping k3s, to start it on the kubelet's new root on the home disk"
      stop_k3s || die "k3s did not stop, so its kubelet cannot move to the home disk"
      was=0
    fi
    kubelet_root_write
  fi
  [ "$was" = 1 ] && RESTART_ON=(${mounted[@]+"${mounted[@]}"})
  return 0
}
RESTART_ON=()

# k3s listens on its config's port, unless its data dir holds a cluster made on another:
# k3s never rewrites the kubeconfigs it keeps there, which name its API server on the port
# after its own, and exits when they disagree. So a cluster keeps the port it was made on.
k3s_port_args() {
  local data api
  data="$(sed -n 's/^data-dir: *//p' "$NODE/etc/rancher/k3s/config.yaml" 2>/dev/null)"
  api="$(sed -n 's#^ *server: https://127.0.0.1:\([0-9]*\)$#\1#p' "$NODE${data:-/var/lib/rancher/k3s}/server/cred/admin.kubeconfig" 2>/dev/null | head -n 1)"
  [ -z "$api" ] || printf -- '--https-listen-port\n%s\n' "$((api - 1))"
}

start_k3s() {
  k3s_running && return 0
  # The VM reaches the outside only through the paired gateway, so containerd and helm
  # need the agent's proxy; cluster-internal ranges bypass it.
  local np="${NO_PROXY:-${no_proxy:-}}"
  np="${np:+$np,}localhost,127.0.0.1,::1,10.42.0.0/16,10.43.0.0/16,.svc,.cluster.local"
  export NO_PROXY="$np" no_proxy="$np"
  [ -n "${HTTPS_PROXY:-${https_proxy:-}}" ] && export CONTAINERD_HTTPS_PROXY="${HTTPS_PROXY:-$https_proxy}" CONTAINERD_NO_PROXY="$np"
  [ -n "${HTTP_PROXY:-${http_proxy:-}}" ] && export CONTAINERD_HTTP_PROXY="${HTTP_PROXY:-$http_proxy}"
  say "starting k3s"
  local port=() a; while IFS= read -r a; do port+=("$a"); done < <(k3s_port_args)
  (umask 022; low k3s server ${port[@]+"${port[@]}"} >"$NODE/var/log/k3s.log" 2>&1 &)
  local i; for i in $(seq 1 60); do k3s_running && break; sleep 5; done
  k3s_running || die "k3s did not become ready in 5 minutes (see /var/log/k3s.log)"
  kc wait --for=condition=Ready node --all --timeout=180s >/dev/null || die "node not Ready"
}

traefik_port() {
  [ "$(cfgv .traefik_port)" = true ] || return 0
  kc apply -f - >/dev/null <<YAML || die "traefik port config failed"
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: traefik
  namespace: kube-system
spec:
  valuesContent: |
    ports:
      app:
        port: $APP_PORT
        expose:
          default: true
        exposedPort: $APP_PORT
        protocol: TCP
YAML
}

step_wait() { # <step json>
  local ns; ns="$(jq -r '.wait.namespace // empty' <<<"$1")"; [ -n "$ns" ] || return 0
  if [ "$(jq -r '.wait.deployments // false' <<<"$1")" = true ]; then
    kc -n "$ns" wait --for=condition=Available deployment --all --timeout=300s >/dev/null || die "$(jq -r .name <<<"$1"): deployments not Available"
  fi
  local r; r="$(jq -r '.wait.rollout // empty' <<<"$1")"
  [ -z "$r" ] || kc -n "$ns" rollout status "$r" --timeout=300s >/dev/null || die "$(jq -r .name <<<"$1"): $r not rolled out"
}

# A manifest's source: its `url`, or its `file` inside the profile directory.
manifest_src() {
  local f; f="$(jq -r '.file // empty' <<<"$1")"
  if [ -z "$f" ]; then jq -r .url <<<"$1"; return; fi
  [ -n "${QI_PROFILE_DIR:-}" ] || die "$(jq -r .name <<<"$1"): a manifest file needs QI_PROFILE_DIR"
  printf '%s/%s\n' "$QI_PROFILE_DIR" "$f"
}

# Prerequisites are installed once, in order, and never upgraded by `up`.
prerequisites() {
  local step kind name unless
  while IFS= read -r step; do
    kind="$(jq -r .kind <<<"$step")"; name="$(jq -r .name <<<"$step")"
    case "$kind" in
      manifest)
        unless="$(jq -r '.unless // empty' <<<"$step")"
        if [ -n "$unless" ] && kc get "$unless" >/dev/null 2>&1; then :; else
          say "installing $name"; kc apply -f "$(manifest_src "$step")" >/dev/null || die "$name: manifest apply failed"
        fi ;;
      helm)
        if ! helm -n "$(jq -r .namespace <<<"$step")" status "$name" >/dev/null 2>&1; then
          say "installing $name"
          local sets=(); while IFS= read -r kv; do [ -n "$kv" ] && sets+=(--set "$kv"); done \
            < <(jq -r '.set // {} | to_entries[] | "\(.key)=\(.value)"' <<<"$step")
          low helm install "$name" "$(jq -r .chart <<<"$step")" --repo "$(jq -r .repo <<<"$step")" \
            -n "$(jq -r .namespace <<<"$step")" --create-namespace --version "$(jq -r .version <<<"$step")" \
            --wait --timeout 10m ${sets[@]+"${sets[@]}"} >/dev/null || die "$name: helm install failed"
        fi ;;
      adopt-crds)
        # Stamp Helm ownership so a release of the cluster's own (e.g. k3s' bundled
        # traefik-crd) adopts CRDs another prerequisite installed out of band.
        local rel ns crd; rel="$(jq -r .release <<<"$step")"; ns="$(jq -r .namespace <<<"$step")"
        for crd in $(jq -r '.crds[]' <<<"$step"); do
          kc label crd "$crd" app.kubernetes.io/managed-by=Helm --overwrite >/dev/null 2>&1 || true
          kc annotate crd "$crd" meta.helm.sh/release-name="$rel" meta.helm.sh/release-namespace="$ns" --overwrite >/dev/null 2>&1 || true
        done ;;
      *) die "unknown prerequisite kind '$kind' ($name)" ;;
    esac
    step_wait "$step"
  done < <(jq -c '.prerequisites // [] | .[]' <<<"$CFG")
}

# The UI answers with a 2xx/3xx within <tries> × 10 s.
ui_answers() { # <tries>
  local i code; for i in $(seq 1 "$1"); do
    code="$(curl -s -o /dev/null -w '%{http_code}' --noproxy '*' --max-time 10 "$(app_url)" 2>/dev/null)"
    case "$code" in (2??|3??) return 0;; esac; [ "$i" = "$1" ] || sleep 10
  done
  return 1
}

cmd_up() {
  local tag="${1:?tag}" tmp chartdir vhash
  [ -f "$CRED" ] || cmd_init
  # The VM's gateway answers every public name with its own address (README → Placeholders).
  QI_GATEWAY_IP="$(getent ahostsv4 github.com 2>/dev/null | awk 'NR == 1 {print $1}')"; export QI_GATEWAY_IP
  ( umask 077; node "$ENGINE_DIR/lib/render.mjs" values "$CRED" <<<"$CFG" > "$ENVD/values.json" ) || die "values rendering failed"
  vhash="$( (sha256sum || shasum -a 256) < "$ENVD/values.json" 2>/dev/null | cut -c1-12)"
  node_prepare
  start_k3s
  restart_pods_on ${RESTART_ON[@]+"${RESTART_ON[@]}"}
  # Already this build with these values (a takeover, the next run on the same candidate, a
  # restarted VM whose cluster comes back from disk): nothing to install once the UI answers.
  if [ "$(jq -r '"\(.build // "")@\(.values // "")"' "$ENVD/STATE.json" 2>/dev/null)" = "$tag@$vhash" ] && ui_answers 30; then
    say "$RELEASE $tag is already up at $(app_url)"; return 0
  fi
  ensure_helm
  traefik_port
  prerequisites
  tmp="/tmp/quality-inspector-chart-$tag"; rm -rf "$tmp"; mkdir -p "$tmp"
  low helm pull "$CHART" --version "$tag" --untar --untardir "$tmp" >/dev/null 2>&1 || { rm -rf "$tmp"; die "helm pull $tag failed"; }
  chartdir="$(find "$tmp" -mindepth 1 -maxdepth 1 -type d | head -1)"
  # Helm never upgrades a chart's crds/ on an existing release — apply them first.
  if [ "$(cfgv .apply_chart_crds)" = true ] && [ -d "$chartdir/crds" ]; then
    kc apply --server-side --force-conflicts -f "$chartdir/crds/" >/dev/null || { rm -rf "$tmp"; die "CRD apply failed"; }
  fi
  say "installing $RELEASE at $tag"
  rm -f "$ENVD/STATE.json"   # recorded again only once this build answers: a failed upgrade is never "up"
  low helm upgrade --install "$RELEASE" "$chartdir" -n "$NS" --create-namespace -f "$ENVD/values.json" \
      --timeout 20m --wait >/dev/null 2>"$tmp/helm.err" \
    || { local e; e="$(tail -5 "$tmp/helm.err")"; rm -rf "$tmp"; die "helm upgrade to $tag failed: $e"; }
  rm -rf "$tmp"
  kc -n "$NS" wait --for=condition=Available deployment --all --timeout=600s >/dev/null || die "deployments not Available"
  ui_answers 60 || die "app not reachable at $(app_url) after 10 minutes"
  printf '{"build":"%s","values":"%s","installed_utc":"%s"}\n' "$tag" "$vhash" "$(now)" > "$ENVD/STATE.json"
  say "$RELEASE $tag is up at $(app_url)"
  # Below prune_below_gi free, the earlier builds' images go; above it they stay, so a
  # switch back (red-green, a bisection) pulls nothing.
  local free; free="$(free_gi)"
  [ -n "$free" ] && [ "$free" -lt "$PRUNE_BELOW_GI" ] && prune_images
  return 0
}

# Images no container uses: every earlier build's after an `up`, this one's too after a
# `reset`. containerd keeps them all otherwise, until the kubelet evicts pods for disk.
prune_images() {
  low k3s crictl rmi --prune >/dev/null 2>&1 && say "removed the images no container uses" \
    || say "image prune failed — continuing"
}
free_gi() { # Gi free where k3s keeps its images; empty when unmeasurable
  { df -Pk /var/lib/rancher 2>/dev/null || df -Pk / 2>/dev/null; } | awk 'NR==2 && $4 ~ /^[0-9]+$/ {print int($4/1048576)}'
}

cmd_reset() {
  k3s_running || die "k3s is not running"
  ensure_helm
  helm -n "$NS" uninstall "$RELEASE" --wait --timeout 10m >/dev/null 2>&1 || true
  kc -n "$NS" delete pvc --all --wait=true --timeout=300s >/dev/null 2>&1 || true
  rm -f "$ENVD/STATE.json"
  prune_images
}

cmd_status() {
  local running=false build="" ui=000
  k3s_running && running=true
  [ -f "$ENVD/STATE.json" ] && build="$(jq -r .build "$ENVD/STATE.json" 2>/dev/null)"
  [ "$running" = true ] && ui="$(curl -s -o /dev/null -w '%{http_code}' --noproxy '*' --max-time 10 "$(app_url)" 2>/dev/null)"
  jq -nc --argjson r "$running" --arg b "$build" --arg u "$ui" --argjson k "$(kvm_state)" \
    '{running:$r, build:(if $b=="" then null else $b end), ui_http:$u} + (if $k == null then {} else {kvm:$k} end)'
}

cmd_down() { pkill -f 'k3s server' 2>/dev/null || true; }

case "${1:-}" in
  init)   cmd_init ;;
  up)     cmd_up "${2:-}" ;;
  reset)  cmd_reset ;;
  status) cmd_status ;;
  down)   cmd_down ;;
  *) echo "usage: $0 init|up <tag>|reset|status|down" >&2; exit 2 ;;
esac
